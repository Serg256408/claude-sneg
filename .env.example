# ============================================
# Переменные окружения SnowForce Dispatch
# ============================================
# Скопируйте этот файл в .env и заполните значения

# Google Gemini AI API ключ (для анализа адресов)
VITE_GEMINI_API_KEY=your_api_key_here

# DaData API ключ (для автодополнения адресов)
# Получить: https://dadata.ru/api/suggest/address/
VITE_DADATA_API_KEY=your_dadata_api_key_here

# Base URL для production (GitHub Pages)
# Для локальной разработки оставьте /
VITE_BASE_URL=/

# Режим работы: development | production
VITE_APP_ENV=development
